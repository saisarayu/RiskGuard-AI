# RiskGuard AI Backend Configuration
# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./riskguard.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riskguard_ai

# Google Gemini API Key for RiskGuard Copilot
GEMINI_API_KEY=your_gemini_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
